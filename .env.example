# LLM provider keys
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Database
# Local / direct connection (port 5432) — SQLAlchemy pool is used
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Render / production — use Supabase's IPv4 transaction pooler (port 6543).
# The app auto-detects port 6543 and switches to NullPool + statement_cache_size=0.
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# CORS — comma-separated list of allowed frontend origins.
# Local dev: http://localhost:3000
# Production: https://your-dashboard.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# PORT is set automatically by Render — do not set it here.
# Locally, uvicorn defaults to 8000.
